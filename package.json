{
  "name": "budgie",
  "version": "1.0.0",
  "private": true,
  "main": "public/electron.js",
  "description": "A simple home finance app built with Electron and React.",
  "author": "Mark Fairhurst",
  "homepage": "./",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "start": "concurrently \"vite\" \"bun run electron-start\"",
    "build": "vite build && vite build --config vite.main.config.ts && vite build --config vite.services.config.ts && bun run electron-build",
    "electron-start": "wait-on http://localhost:3000 && vite build --config vite.main.config.ts && electron .",
    "electron-build": "electron-builder",
    "electron-build:win": "electron-builder --win",
    "build:web": "vite build --config vite.config.ts",
    "verify:web": "bun run build:web && bun run scripts/verify-web-build.ts",
    "test": "vitest run",
    "test:e2e": "bun run vite build && playwright test",
    "lint": "eslint --fix",
    "check-types": "node node_modules/typescript7/bin/tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:migrate": "drizzle-kit generate",
    "db:seed": "bun run src/main/db/seeds/accounts.ts",
    "export:portable": "bun run scripts/export-portable.ts",
    "spike:powersync": "vite --config vite.powersync-spike.config.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-table": "^9.3.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "rrule": "^2.8.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@powersync/web": "2.3.1",
    "@prettier/plugin-oxc": "^0.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/eslint": "^9.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-motion": "^1.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.markfairhurst.budgie",
    "productName": "Budgie",
    "icon": "public/assets/icon.icns",
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "public/db.js",
      "public/services.js",
      "public/services-adapter.js",
      "public/ipc/**/*",
      "src/main/db/migrations/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "out"
    },
    "publish": {
      "provider": "github",
      "owner": "airburst",
      "repo": "budgie",
      "timeout": 300000
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "deb"
    },
    "npmRebuild": false
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
